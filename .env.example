# Denver – Built Beyond Ordinary
# Environment Variables

# ── Firebase ──────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ── Cloudinary ────────────────────────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_name

# IMPORTANT:
# 1. Copy this file to `.env` and fill in real values.
# 2. Never commit `.env` — it is in .gitignore.
# 3. The Cloudinary upload preset must be set to "Unsigned" in your Cloudinary console.
# 4. Firebase Spark plan — no Cloud Functions or Firebase Storage is required.
